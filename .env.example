# Copy this file to .env, replace only the placeholder values, and keep .env local.
# The application reads environment variables; load it explicitly before running locally:
#   set -a; . ./.env; set +a

# URL of the OpenAI-compatible upstream. Do not publish a real endpoint.
PRIVACY_GATEWAY_UPSTREAM_BASE_URL=http://127.0.0.1:8080/v1

# Bind to loopback unless a deliberate network exposure is required.
PRIVACY_GATEWAY_HOST=127.0.0.1
PRIVACY_GATEWAY_PORT=8000
PRIVACY_GATEWAY_STRICT=true

# Optional contextual pseudonymization map. Copy examples/context-map.example.json to
# a private location, replace its fictional entries locally, and never commit it.
PRIVACY_GATEWAY_CONTEXT_MAP_PATH=/absolute/path/to/private-context-map.json

# Optional but recommended when a context map is enabled. Use a stable, high-entropy
# secret generated for this deployment only; never commit or share its real value.
PRIVACY_GATEWAY_PSEUDONYMIZATION_TOKEN_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

