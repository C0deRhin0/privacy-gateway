[Unit]
Description=Privacy Gateway (PII redaction in front of Headroom)
After=network-online.target headroom-proxy.service
Wants=network-online.target headroom-proxy.service

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/srv/workspaces/Github/privacy-gateway/codebase
Environment="HOME=/home/hermes"
Environment="USER=hermes"
Environment="LOGNAME=hermes"
Environment="PATH=/srv/workspaces/Github/privacy-gateway/codebase/.venv/bin:/home/hermes/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/srv/workspaces/Github/privacy-gateway/codebase/.venv"
Environment="PRIVACY_GATEWAY_UPSTREAM_BASE_URL=http://127.0.0.1:18787/v1"
Environment="PRIVACY_GATEWAY_HOST=127.0.0.1"
Environment="PRIVACY_GATEWAY_PORT=14000"
ExecStart=/srv/workspaces/Github/privacy-gateway/codebase/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 14000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
